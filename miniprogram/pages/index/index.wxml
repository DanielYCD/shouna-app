<view class="page">
  <view class="hero card">
    <view class="muted">当前家庭</view>
    <view class="hero-title">{{familyName || '未选择家庭'}}</view>
    <view class="row" style="margin-top:8rpx;">
      <view class="hero-stat"><text class="big">{{stats.items}}</text><text class="muted">件物品</text></view>
      <view class="hero-stat"><text class="big">{{stats.categories}}</text><text class="muted">个分类</text></view>
      <view class="hero-stat"><text class="big">{{stats.floors}}</text><text class="muted">张户型</text></view>
    </view>
  </view>

  <view class="card">
    <view class="card-title">快速操作</view>
    <view class="actions">
      <view class="action" bindtap="goAdd">
        <view class="action-ic" style="background:#CC1414;">＋</view>
        <text>记一笔</text>
      </view>
      <view class="action" bindtap="goItems">
        <view class="action-ic" style="background:#1677FF;">☰</view>
        <text>找东西</text>
      </view>
      <view class="action" bindtap="goMap">
        <view class="action-ic" style="background:#52C41A;">⌖</view>
        <text>看户型</text>
      </view>
      <view class="action" bindtap="goFamily">
        <view class="action-ic" style="background:#FA8C16;">⌂</view>
        <text>家庭</text>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="row-between">
      <view class="card-title" style="margin:0;">最近记录</view>
      <text class="muted" bindtap="goItems">查看全部 ›</text>
    </view>
    <view wx:if="{{recent.length === 0}}" class="muted" style="padding:24rpx 0;">还没有物品，点「记一笔」开始收纳吧</view>
    <view wx:for="{{recent}}" wx:key="_id" class="recent-item" data-id="{{item._id}}" bindtap="openItem">
      <image wx:if="{{item.photoFileId}}" class="thumb" src="{{item.photoFileId}}" mode="aspectFill"></image>
      <view wx:else class="thumb thumb-empty">{{item.category}}</view>
      <view style="flex:1;">
        <view class="title" style="font-size:30rpx;">{{item.name}}</view>
        <view class="muted">{{item.category}}<text wx:if="{{item.note}}"> · {{item.note}}</text></view>
      </view>
    </view>
  </view>
</view>

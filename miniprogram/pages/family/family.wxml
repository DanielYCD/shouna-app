<view class="page">
  <view class="card" wx:if="{{families.length > 1}}">
    <view class="card-title">切换家庭</view>
    <view
      wx:for="{{families}}"
      wx:key="_id"
      class="fam-switch {{currentFamilyId === item._id ? 'active' : ''}}"
      data-id="{{item._id}}"
      bindtap="switchFamily"
    >
      <text>{{item.name}}</text>
      <text wx:if="{{currentFamilyId === item._id}}" class="primary">当前</text>
    </view>
  </view>

  <view class="card" wx:if="{{current}}">
    <view class="row-between">
      <view class="title">{{current.name}}</view>
      <text class="muted">{{isOwner ? '创建者' : '成员'}}</text>
    </view>
    <view class="divider"></view>
    <view class="row-between invite">
      <view>
        <view class="muted">家庭邀请码</view>
        <view class="invite-code">{{inviteCode}}</view>
      </view>
      <view class="btn-line copy" bindtap="copyCode">复制</view>
    </view>
    <view class="muted" style="margin-top:8rpx;">把邀请码发给家人，即可在家庭里共享物品</view>
  </view>

  <view class="card" wx:if="{{current}}">
    <view class="card-title">成员（{{members.length}}）</view>
    <view wx:for="{{members}}" wx:key="masked" class="member">
      <text>{{item.masked}}</text>
      <text class="muted">{{item.role === 'owner' ? '创建者' : '成员'}}</text>
    </view>
  </view>

  <view class="card" wx:if="{{current}}">
    <view class="card-title">分类管理</view>
    <view>
      <text
        wx:for="{{current.categories}}"
        wx:key="*this"
        class="tag"
        data-name="{{item}}"
        bindtap="delCategory"
      >{{item}} ✕</text>
    </view>
    <view class="btn-ghost add-cat" bindtap="addCategory">＋ 新增分类</view>
  </view>

  <view class="card">
    <view class="btn-line act" bindtap="joinFamily">加入家庭</view>
    <view class="btn-primary act" bindtap="createFamily">创建新家庭</view>
  </view>

  <view class="card" wx:if="{{current && isOwner}}">
    <view class="card-title">管理</view>
    <view class="btn-ghost act" bindtap="renameFamily">重命名家庭</view>
    <view class="btn-ghost act" bindtap="refreshCode">刷新邀请码</view>
    <view class="btn-del act" bindtap="delFamily">删除家庭</view>
  </view>

  <view class="muted center">我的身份：{{maskedOpenid}}</view>
</view>

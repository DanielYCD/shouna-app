.photo-row {
  display: flex;
  align-items: center;
}
.photo {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
}
.photo-add {
  background: #f2f2f2;
  color: #999;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx dashed #ccc;
}
.photo-del {
  margin-left: 24rpx;
  padding: 12rpx 28rpx;
}
.save-btn {
  margin-top: 12rpx;
}

<view class="page">
  <view class="card">
    <view class="field">
      <view class="field-label">名称</view>
      <input class="field-input" placeholder="如：戴森吸尘器" value="{{name}}" bindinput="onName" />
    </view>

    <view class="field">
      <view class="field-label">分类</view>
      <picker mode="selector" range="{{categories}}" value="{{categoryIndex}}" bindchange="onCategory">
        <view class="field-input">{{categories[categoryIndex]}} ›</view>
      </picker>
    </view>

    <view class="field">
      <view class="field-label">数量</view>
      <input class="field-input" type="number" placeholder="可选" value="{{quantity}}" bindinput="onQty" />
    </view>

    <view class="field" style="border-bottom:none;">
      <view class="field-label">备注</view>
      <input class="field-input" placeholder="存放位置/规格等" value="{{note}}" bindinput="onNote" />
    </view>
  </view>

  <view class="card">
    <view class="card-title">照片</view>
    <view class="photo-row">
      <image wx:if="{{photoPath}}" class="photo" src="{{photoPath}}" mode="aspectFill" bindtap="choosePhoto"></image>
      <view wx:else class="photo photo-add" bindtap="choosePhoto">＋ 拍照/相册</view>
      <view wx:if="{{photoPath}}" class="btn-ghost photo-del" bindtap="removePhoto">移除</view>
    </view>
    <view class="muted" style="margin-top:10rpx;">户型图标记请在「看户型」中设置</view>
  </view>

  <button class="btn-primary save-btn" loading="{{submitting}}" bindtap="save">保存</button>
  <button wx:if="{{mode === 'edit'}}" class="btn-ghost save-btn" bindtap="remove">删除该物品</button>
</view>

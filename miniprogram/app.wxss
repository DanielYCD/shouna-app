page {
  background: #f5f5f5;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC", sans-serif;
  color: #222;
}

.page {
  padding: 24rpx;
  box-sizing: border-box;
  min-height: 100vh;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.card-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
  color: #333;
}

.muted {
  color: #999;
  font-size: 24rpx;
}

.title {
  font-size: 34rpx;
  font-weight: 600;
}

.primary {
  color: #CC1414;
}

.btn-primary {
  background: #CC1414;
  color: #fff;
  border-radius: 12rpx;
  font-size: 30rpx;
}

.btn-line {
  background: #fff;
  color: #CC1414;
  border: 1rpx solid #CC1414;
  border-radius: 12rpx;
  font-size: 30rpx;
}

.btn-ghost {
  background: #f2f2f2;
  color: #666;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.row {
  display: flex;
  align-items: center;
}

.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.divider {
  height: 1rpx;
  background: #eee;
  margin: 16rpx 0;
}

.field {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.field-label {
  width: 160rpx;
  color: #666;
  font-size: 28rpx;
}

.field-input {
  flex: 1;
  font-size: 28rpx;
}

.tag {
  display: inline-block;
  padding: 8rpx 22rpx;
  background: #f2f2f2;
  color: #666;
  border-radius: 999rpx;
  font-size: 26rpx;
  margin: 0 16rpx 16rpx 0;
}

.tag.active {
  background: #CC1414;
  color: #fff;
}
